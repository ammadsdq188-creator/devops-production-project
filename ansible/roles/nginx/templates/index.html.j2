{# Server information page generated by Ansible #}

<h1>{{ website_name | upper }}</h1>
<p>Handler Test - Version 2</p>

{% if deployment_environment == "production" %}
<p>Environment: PRODUCTION</p>
{% elif deployment_environment == "staging" %}
<p>Environment: STAGING</p>
{% else %}
<p>Environment: DEVELOPMENT</p>
{% endif %}

<p>Server: {{ server_name | default("Unknown Server") }}</p>
